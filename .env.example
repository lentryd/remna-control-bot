# Telegram bot token from @BotFather
BOT_TOKEN=
# open — anyone can join; closed — only panel customers / subscription link / referral link
BOT_MODE=closed
# vpn-control base URL and an API token created with the "bot" preset
VPNCTL_URL=http://vpn-control:8080
VPNCTL_TOKEN=
# Public origin where the WebApp is served; WEBAPP_PATH is appended
PUBLIC_URL=https://control.example.com
WEBAPP_PATH=/bot
# Secret for referral codes. Changing it invalidates every issued referral link.
REF_SECRET=
# Renewals from the balance: mixed — own and referral money together;
# referral_full — referral money only when it covers the whole price.
BALANCE_PAY_MODE=mixed
# Notifications: how often to check (0 turns them off), traffic share that
# triggers an alert, days before the end to remind about payment.
NOTIFY_INTERVAL=1h
TRAFFIC_ALERT_PCT=80
REMIND_DAYS=3,1
# Manual payments (all three required to enable): chat that receives receipts
# (add the bot to the group), comma-separated admin Telegram ids, payment
# details shown with the amount ("\n" for line breaks); unpaid orders expire
# after ORDER_TTL.
ADMIN_CHAT_ID=
ADMIN_IDS=
MANUAL_PAY_DETAILS=
ORDER_TTL=48h
HTTP_ADDR=:8090
DB_PATH=./data/bot.db
LOG_LEVEL=info

# Local development (compose.dev.yml): a subdomain of your own domain that
# resolves to 127.0.0.1 via /etc/hosts, e.g. local.example.com
LOCAL_DOMAIN=

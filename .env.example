# Telegram bot token from @BotFather
BOT_TOKEN=
# open — anyone can join; closed — only panel customers / subscription link / referral link
BOT_MODE=closed
# vpn-control base URL and an API token created with the "bot" preset
VPNCTL_URL=http://vpn-control:8080
VPNCTL_TOKEN=
# Public origin where the WebApp is served; WEBAPP_PATH is appended
PUBLIC_URL=https://control.example.com
WEBAPP_PATH=/bot
# Secret for referral codes. Changing it invalidates every issued referral link.
REF_SECRET=
# Renewals from the balance: mixed — own and referral money together;
# referral_full — referral money only when it covers the whole price.
BALANCE_PAY_MODE=mixed
# Notifications: how often to check (0 turns them off), traffic share that
# triggers an alert, days before the end to remind about payment.
NOTIFY_INTERVAL=1h
TRAFFIC_ALERT_PCT=80
REMIND_DAYS=3,1
# Manual payments (all three required to enable): chat that receives receipts
# (add the bot to the group), comma-separated admin Telegram ids, payment
# details shown with the amount ("\n" for line breaks); unpaid orders expire
# after ORDER_TTL.
ADMIN_CHAT_ID=
ADMIN_IDS=
MANUAL_PAY_DETAILS=
ORDER_TTL=48h
# Fallback while the panel can't tell its base currency (the bot reads `base_currency` from the panel; needs the token scope `stats:settings` — re-issue an old bot token). Provider invoices stay disabled until the panel answers or this is set explicitly
BASE_CURRENCY=RUB
# Online payment providers; each turns on when its keys are set. Webhooks go to
# PUBLIC_URL/pay/<provider> (yookassa, cryptobot, heleket, pal24, platega) — PUBLIC_URL must be
# https and reachable from the internet.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# After paying the customer lands here (default: the WebApp)
YOOKASSA_RETURN_URL=
# Fiscal receipt: set the customer e-mail (and the VAT code, 1..6) to send one
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_VAT_CODE=1
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
# Accepted assets, e.g. USDT,TON (empty: all)
CRYPTOBOT_ASSETS=
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_TO_CURRENCY=
HELEKET_NETWORK=
PAL24_API_TOKEN=
PAL24_SHOP_ID=
# Postback signing token (empty: the API token)
PAL24_SIGNATURE_TOKEN=
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# 2 SBP QR, 11 cards, 12 international cards, 13 crypto
PLATEGA_PAYMENT_METHOD=2
# v2 for merchants whose card cascades only work in v2
PLATEGA_API_VERSION=v1
PLATEGA_RETURN_URL=
PLATEGA_FAILED_URL=
# Base-currency units per Telegram Star; > 0 turns Stars on
STARS_RATE=
HTTP_ADDR=:8090
DB_PATH=./data/bot.db
LOG_LEVEL=info

# Local development (compose.dev.yml): a subdomain of your own domain that
# resolves to 127.0.0.1 via /etc/hosts, e.g. local.example.com
LOCAL_DOMAIN=

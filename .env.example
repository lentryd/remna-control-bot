# Telegram bot token from @BotFather
BOT_TOKEN=
# Remna Control base URL and an API token created with the "Telegram bot" preset.
# Next to the panel's compose.yml it is reachable by its container name.
REMNACTL_URL=http://vpn-control:8080
REMNACTL_TOKEN=
# Public origin where the WebApp is served; WEBAPP_PATH is appended.
# Payment providers send webhooks to PUBLIC_URL/pay/<provider>, so it must be https and reachable.
PUBLIC_URL=https://control.example.com
WEBAPP_PATH=/bot
# Secret for referral codes. It also derives the key that encrypts payment credentials stored in the database:
# changing it invalidates every referral link and the stored credentials must be entered again.
REF_SECRET=
# REQUIRED. Comma-separated Telegram ids of the admins. They get order cards as private messages (each must press /start in the
# bot once) and may open the admin part of the WebApp (/admin in the bot, or the button on a card). Payment methods,
# bot mode, notifications and the rest are configured there, not here.
ADMIN_IDS=
HTTP_ADDR=:8090
DB_PATH=./data/bot.db
LOG_LEVEL=info

# Docker deployment (compose.yml): the domain Remna Control is served at; the bot takes WEBAPP_PATH and /pay/ on it,
# so PUBLIC_URL above is https://$APP_DOMAIN. The rest must match the panel's docker network and Traefik.
APP_DOMAIN=control.example.com
REMNAWAVE_NETWORK=remnawave-network
TRAEFIK_ENTRYPOINTS=web,websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Local development (compose.dev.yml): a subdomain of your own domain that
# resolves to 127.0.0.1 via /etc/hosts, e.g. local.example.com
LOCAL_DOMAIN=
